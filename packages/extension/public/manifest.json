{
  "manifest_version": 3,
  "name": "ShieldWall — AI Transaction Firewall",
  "version": "0.1.0",
  "description": "AI-powered Web3 transaction firewall. Know what you sign before you sign it.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://*.etherscan.io/*",
    "https://*.arbiscan.io/*",
    "https://*.basescan.org/*",
    "https://*.polygonscan.com/*",
    "https://*.bscscan.com/*",
    "https://api.coingecko.com/*",
    "https://www.4byte.directory/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "ShieldWall"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
